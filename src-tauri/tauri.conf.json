{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token Dashboard",
  "version": "0.1.0",
  "identifier": "io.github.junonarchive.token-dashboard",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "claude-widget",
        "title": "Token Dashboard",
        "width": 340,
        "height": 180,
        "minWidth": 340,
        "minHeight": 180,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": []
  }
}
